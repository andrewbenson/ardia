#!/bin/bash
repo="$(cd "$(dirname "$0")/../.." && pwd -P)"
lsr=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
"$lsr" -dump 2>/dev/null | sed -En 's/^path: *(.*\/Solara[^/]*\.app) \(0x.*/\1/p' | grep -v '/Contents/' | sort -u |
  while IFS= read -r app; do
    case "$app" in
      */dist/*-rc/* | */build-vista/*) ;;
      "$repo"/* | /private/tmp/claude-*/* | /private/tmp/ac-*/* | "$HOME"/.cache/solara-lead/*) "$lsr" -u "$app" 2>/dev/null ;;
    esac
  done
