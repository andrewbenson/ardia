#!/bin/bash
# Builds the app into your own derived data, quietly: the full log goes to a file, and you see only what you need.
#
#   scripts/agent/build-app [--as NAME] [--config Debug|Release] [--force] [--wait SECS]
#   scripts/agent/build-app -h | --help
#
# --as NAME     your agent name (default: $AC_LOCKED_AS, else "dev"). Builds into apps/browser/build-NAME, and is
#               passed to `locked` so a chromium take of yours covers the engine staging.
# --config      Debug (default) or Release.
# --force       build even when no native file changed.
# --wait SECS   how long to wait for a pod install, or for another build into the same derived data (default 1500).
#
# - Runs `pnpm pods` first (under the pod lock) when a source file in packages/*/ios is on disk but not in the Pods
#   project, or the Pods project lists one that's gone, since Xcode only compiles the files a pod install listed. A
#   difference the install doesn't change (a file its podspec leaves out) is remembered and not reinstalled for.
#
# - Incremental: keep using the same name. A new derived data compiles everything (a few minutes), and so does a copy
#   of another one (its paths differ, so Xcode rebuilds all 1040 compiles; measured 2026-10-02).
# - It refuses a Debug build that can't change the app: when no native file differs from the last successful build
#   here (packages/*/ios, apps/browser/macos, the Pods, patches, the engine framework…), it prints
#   "JS-only: Metro reloads it; no build needed" and exits 0. Pass --force to build anyway.
# - Prints the errors (a failed build script with its last 30 lines), the warnings count, the result, the time and
#   the .app path. The full log: <derived data>/build-app.log.
# - Signs with the identity's team when a macOS development profile for its bundle id is installed, else ad hoc
#   (macos/AdHoc.xcconfig), and says so.
# Builds into different derived data run in parallel (scripts/agent/locked --help). Run it with run_in_background.
# Exits 0 when built (or nothing to build), 1 when the build failed, 75 when a lock stayed busy.
set -uo pipefail

help() {
  awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
  exit 0
}
usage() {
  sed -n '4,5p' "$0" | sed 's/^# *//' >&2
  exit 64
}

name=${AC_LOCKED_AS:-dev} config=Debug force="" wait=1500
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h | --help) help ;;
    --force) force=1; shift; continue ;;
  esac
  [[ $# -ge 2 ]] || { echo "build-app: $1 needs a value" >&2; usage; }
  case "$1" in
    --as) name="$2" ;;
    --config) config="$2" ;;
    --wait) wait="$2" ;;
    *) echo "build-app: unknown option $1" >&2; usage ;;
  esac
  shift 2
done
[[ "$config" == Debug || "$config" == Release ]] || { echo "build-app: --config is Debug or Release" >&2; usage; }
[[ "$name" =~ ^[A-Za-z0-9._-]+$ ]] || { echo "build-app: --as takes letters, digits, . _ -" >&2; usage; }

repo=$(cd "$(dirname "$0")/../.." && pwd)
app_dir="$repo/apps/browser"
dd="$app_dir/build-$name"
log="$dd/build-app.log"
. "$repo/scripts/identity.sh"
app="$dd/Build/Products/$config/$(ac_identity FULL_PRODUCT_NAME)"

has_development_profile() {
  python3 -I - "$1" "$2" <<'PY'
import glob, os, plistlib, subprocess, sys
from datetime import datetime, timezone
team, bundle = sys.argv[1:3]
folders = ["~/Library/Developer/Xcode/UserData/Provisioning Profiles", "~/Library/MobileDevice/Provisioning Profiles"]
for path in sorted(p for folder in folders for p in glob.glob(os.path.join(os.path.expanduser(folder), "*.provisionprofile"))):
    try:
        profile = plistlib.loads(subprocess.run(["security", "cms", "-D", "-i", path], capture_output=True, check=True).stdout)
    except (subprocess.CalledProcessError, ValueError):
        continue
    entitlements = profile.get("Entitlements", {})
    app_id = entitlements.get("com.apple.application-identifier") or entitlements.get("application-identifier") or ""
    expires = profile.get("ExpirationDate")
    if team not in profile.get("TeamIdentifier", []) or "OSX" not in profile.get("Platform", []):
        continue
    if expires and expires.replace(tzinfo=timezone.utc) < datetime.now(timezone.utc):
        continue
    if not entitlements.get("com.apple.security.get-task-allow") and not profile.get("ProvisionedDevices"):
        continue
    if app_id == f"{team}.{bundle}" or (app_id.endswith("*") and f"{team}.{bundle}".startswith(app_id[:-1])):
        sys.exit(0)
sys.exit(1)
PY
}
signing=()
team_id=$(ac_identity AC_TEAM_ID)
bundle_id=$(ac_identity AC_BUNDLE_ID)
if ! has_development_profile "$team_id" "$bundle_id"; then
  signing=(-xcconfig macos/AdHoc.xcconfig)
  echo "build-app: no macOS development profile for $team_id.$bundle_id on this Mac; signing ad hoc (macos/AdHoc.xcconfig)"
fi
stamp_file="$dd/.ac-native-stamp-$config"

native_stamp() {
  (
    cd "$repo" || exit 1
    git ls-files -co --exclude-standard -- \
      apps/browser/macos apps/browser/app.json apps/browser/react-native.config.js \
      'packages/*/ios/*' 'packages/*/expo-module.config.json' packages/shell/docktile \
      packages/ardiacore/scripts/embed.sh packages/ardiacore/scripts/stage-framework.sh packages/ardiacore/scripts/ubo.sh \
      packages/ardiacore/extensions \
      packages/ardiacore/scripts/signing engine/ardiacore/src/ardia/core/public patches pnpm-lock.yaml \
      native/SolaraKit/Package.swift native/SolaraKit/Package.resolved native/SolaraKit/Sources
    echo apps/browser/macos/Pods/Manifest.lock
  ) | python3 -c '
import hashlib, os, sys
repo, framework = sys.argv[1], sys.argv[2]
h = hashlib.sha256()
for rel in sorted(set(sys.stdin.read().split("\n")) - {""}):
    path = os.path.join(repo, rel)
    if os.path.isfile(path):
        h.update(rel.encode() + b"\0" + hashlib.sha256(open(path, "rb").read()).digest())
binary = os.path.join(framework, "Versions/Current/Chromium Framework")
if os.path.exists(binary):
    st = os.stat(binary)
    h.update(("engine %s %d %d" % (framework, st.st_mtime, st.st_size)).encode())
print(h.hexdigest())
' "$repo" "${ARDIACORE_FRAMEWORK:-$HOME/chromium-build/chromium_git/chromium/src/out/Release_GN_arm64/Chromium Framework.framework}"
}

pod_drift() {
  python3 -I - "$repo" <<'PY'
import os, re, subprocess, sys
repo = sys.argv[1]
pods = os.path.join(repo, "apps/browser/macos/Pods")
text = open(os.path.join(pods, "Pods.xcodeproj/project.pbxproj"), errors="replace").read()
objects = {}
current = None
for line in text.split("\n"):
    m = re.match(r"\t\t([0-9A-F]{14,24}) (?:/\* .*? \*/ )?= \{(.*)$", line)
    if m and current is None:
        if m.group(2).endswith("};"):
            objects[m.group(1)] = m.group(2)
        else:
            current, lines = m.group(1), [m.group(2)]
        continue
    if current is not None:
        if line == "\t\t};":
            objects[current] = "\n".join(lines)
            current = None
        else:
            lines.append(line)
def field(body, name):
    m = re.search(r"\b" + name + r" = (\"(?:[^\"\\]|\\.)*\"|[^;]+);", body)
    return m and m.group(1).strip('"')
parent = {}
for oid, body in objects.items():
    if "isa = PBXGroup" in body or "isa = PBXVariantGroup" in body:
        m = re.search(r"children = \((.*?)\);", body, re.S)
        for child in re.findall(r"([0-9A-F]{14,24})", m.group(1) if m else ""):
            parent[child] = oid
cache = {}
def path_of(oid):
    if oid in cache:
        return cache[oid]
    body = objects.get(oid, "")
    p, tree = field(body, "path"), field(body, "sourceTree")
    if tree == "SOURCE_ROOT":
        base = pods
    elif tree == "<group>" and oid in parent:
        base = path_of(parent[oid])
    else:
        base = pods
    out = os.path.normpath(os.path.join(base, p)) if p else base
    cache[oid] = out
    return out
exts = (".swift", ".m", ".mm", ".h", ".c", ".cpp", ".metal")
packages = os.path.join(repo, "packages")
listed = set()
for oid, body in objects.items():
    if "isa = PBXFileReference" in body:
        full = path_of(oid)
        if full.startswith(packages + os.sep) and "/ios/" in full and full.endswith(exts):
            listed.add(os.path.relpath(full, repo))
files = subprocess.run(["git", "-C", repo, "ls-files", "-co", "--exclude-standard", "--", "packages/*/ios/*"], capture_output=True, text=True).stdout.split("\n")
present = {f for f in files if f.endswith(exts) and os.path.isfile(os.path.join(repo, f))}
for f in sorted(present - listed):
    print("+ " + f)
for f in sorted(listed - present):
    print("- " + f)
PY
}

mkdir -p "$dd"
drift_file="$dd/.ac-pod-drift"
drift=$(pod_drift) || { echo "build-app: couldn't compare the pod sources with the Pods project" >&2; drift=""; }
if [[ -n "$drift" && "$drift" != "$(cat "$drift_file" 2>/dev/null)" ]]; then
  echo "build-app: the Pods project is behind packages/*/ios ($(echo "$drift" | wc -l | tr -d ' ') file(s), first: $(echo "$drift" | head -1)); running pnpm pods"
  if ! (cd "$repo" && scripts/agent/locked pod --wait "$wait" --as "$name" -- pnpm pods) >"$dd/pods.log" 2>&1; then
    echo "build-app: pnpm pods failed (log: ${dd#"$repo"/}/pods.log)" >&2
    tail -20 "$dd/pods.log" >&2
    exit 1
  fi
  drift=$(pod_drift) || drift=""
  [[ -n "$drift" ]] && echo "build-app: still not in the Pods project after pnpm pods: $(echo "$drift" | tr '\n' ' ')"
fi
printf '%s' "$drift" >"$drift_file"

stamp=$(native_stamp) || { echo "build-app: couldn't hash the native files" >&2; exit 1; }
stamp+=" signing:${signing[*]:-team}"
if [[ -z "$force" && $config == Debug && -d "$app" && -f "$stamp_file" && "$(cat "$stamp_file")" == "$stamp" ]]; then
  echo "JS-only: Metro reloads it; no build needed (no native file changed since $app was built; --force builds anyway)"
  exit 0
fi

start=$(date +%s)
mkdir -p "$dd"

echo "build-app: $config into ${dd#"$repo"/} (log: ${log#"$repo"/})"
(
  cd "$app_dir" &&
    "$repo/scripts/agent/locked" xcodebuild --wait "$wait" --as "$name" -- \
      xcodebuild -workspace macos/Ardia.xcworkspace -scheme Ardia-macOS -derivedDataPath "$dd" \
      -destination 'platform=macOS,arch=arm64' -configuration "$config" ${signing[@]+"${signing[@]}"} -hideShellScriptEnvironment build
) >"$log" 2>&1
status=$?
elapsed=$(($(date +%s) - start))

python3 - "$log" <<'PY'
import re, sys
lines = open(sys.argv[1], errors="replace").read().split("\n")
seen, errors = set(), []
for line in lines:
    if re.search(r"(^|\s)(fatal )?error:|^locked: ", line) and "MACOSX_DEPLOYMENT_TARGET" not in line:
        key = line.strip()
        if key not in seen:
            seen.add(key)
            errors.append(key)
for line in errors[:40]:
    print(line)
if len(errors) > 40:
    print(f"… {len(errors) - 40} more errors in the log")
failed = []
if "The following build commands failed:" in lines:
    i = lines.index("The following build commands failed:") + 1
    while i < len(lines) and lines[i].startswith("\t"):
        failed.append(lines[i].strip())
        i += 1
for command in failed:
    if not command.startswith(("(", "Building workspace")):
        print("failed: " + command)
    m = re.match(r"PhaseScriptExecution (.*?\.sh)", command)
    if not m:
        continue
    head = "PhaseScriptExecution " + m.group(1)
    starts = [i for i, l in enumerate(lines) if l.startswith(head)]
    if not starts:
        continue
    block = []
    for l in lines[starts[-1] + 1:]:
        if l.startswith("** ") or (block and block[-1] == "" and re.match(r"^[A-Z][A-Za-z]+ ", l)):
            break
        block.append(l)
    body = [l for l in block if not l.startswith("    ")]
    while body and body[-1] == "":
        body.pop()
    print("  last 30 lines of its output:")
    for l in body[-30:]:
        print("    " + l)
PY
warnings=$(grep -E '(^|[[:space:]])warning:' "$log" | grep -v MACOSX_DEPLOYMENT_TARGET | sort -u | wc -l | tr -d ' ')
duration="$((elapsed / 60))m $((elapsed % 60))s"
if [[ $status -eq 0 ]] && grep -q '\*\* BUILD SUCCEEDED \*\*' "$log"; then
  echo "$stamp" >"$stamp_file"
  echo "warnings: $warnings"
  echo "BUILD SUCCEEDED in $duration"
  echo "app: $app"
  exit 0
fi
echo "warnings: $warnings"
if [[ $status -eq 75 ]]; then
  echo "NOT BUILT: a lock stayed busy for ${wait}s (above); nothing was built"
  exit 75
fi
echo "BUILD FAILED in $duration (full log: $log)"
exit 1
