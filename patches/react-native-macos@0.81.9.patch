+// [Solara: a single-line field given pastedTypes pastes only those as plain text, with line breaks folded the way
+// Chrome's omnibox folds them (OmniboxView::SanitizeTextForPaste): leading and trailing whitespace goes, and a
+// whitespace run holding a line break becomes one space when the text has other spaces (prose), or nothing when it
+// doesn't (a URL wrapped over lines). A rich paste instead took the source's look, and a link copied with its title
+// pasted the title.
+static NSString *RCTUISingleLinePastedText(NSString *text)
+{
+  NSCharacterSet *space = NSCharacterSet.whitespaceAndNewlineCharacterSet;
+  NSCharacterSet *lineBreak = [NSCharacterSet characterSetWithCharactersInString:@"\r\n"];
+  NSUInteger length = text.length;
+  NSUInteger index = 0;
+  while (index < length && [space characterIsMember:[text characterAtIndex:index]]) {
+    index++;
+  }
+  if (length == 0) {
+    return @"";
+  }
+  if (index == length) {
+    return @" ";
+  }
+  NSMutableString *joined = [NSMutableString string];
+  NSMutableArray<NSNumber *> *lineGaps = [NSMutableArray array];
+  BOOL spaced = NO;
+  while (index < length) {
+    NSUInteger word = index;
+    while (index < length && ![space characterIsMember:[text characterAtIndex:index]]) {
+      index++;
+    }
+    [joined appendString:[text substringWithRange:NSMakeRange(word, index - word)]];
+    NSUInteger gap = index;
+    while (index < length && [space characterIsMember:[text characterAtIndex:index]]) {
+      index++;
+    }
+    if (index == length) {
+      break;
+    }
+    NSRange gapRange = NSMakeRange(gap, index - gap);
+    if ([text rangeOfCharacterFromSet:lineBreak options:0 range:gapRange].location == NSNotFound) {
+      spaced = YES;
+      [joined appendString:[text substringWithRange:gapRange]];
+    } else {
+      [lineGaps addObject:@(joined.length)];
+    }
+  }
+  NSString *fill = spaced ? @" " : @"";
+  for (NSNumber *at in lineGaps.reverseObjectEnumerator) {
+    [joined insertString:fill atIndex:at.unsignedIntegerValue];
+  }
+  return joined;
+}
+
