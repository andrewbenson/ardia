#!/bin/bash
lsr=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
"$lsr" -dump 2>/dev/null | sed -En 's/^path: *(.*\/(Ardia|Solara)[^/]*\.app) \(0x.*/\1/p' | grep -v '/Contents/' | sort -u |
  while IFS= read -r app; do
    case "$app" in
      /Applications/Ardia.app | /Applications/Solara.app | */dist/*-rc/export/Ardia.app | */dist/*-rc/export/Solara.app) ;;
      *) "$lsr" -u "$app" 2>/dev/null ;;
    esac
  done
