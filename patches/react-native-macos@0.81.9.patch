+- (void)pasteFrom:(NSPasteboard *)pasteboard
+{
+  NSMutableArray<NSPasteboardType> *types = [self.pasteTypes mutableCopy];
+  if ([types containsObject:NSPasteboardTypeString]) {
+    [types addObject:NSPasteboardTypeURL];
