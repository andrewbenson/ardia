+void PasswordStore::SetArdiaSyncMarkAsync(
+    const std::string& key,
+    const std::string& value,
+    base::OnceCallback<void(bool)> callback) {
+  DCHECK(main_task_runner_->RunsTasksInCurrentSequence());
+  if (!backend_) {
+    std::move(callback).Run(false);
+    return;
+  }
+  if (post_init_callback_) {
+    post_init_callback_ =
+        std::move(post_init_callback_)
+            .Then(base::BindOnce(&PasswordStore::SetArdiaSyncMarkAsync, this,
+                                 key, value, std::move(callback)));
+    return;
+  }
+  backend_->SetArdiaSyncMarkAsync(key, value, std::move(callback));
+}
